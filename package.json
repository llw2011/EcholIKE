{
  "name": "echolike",
  "private": true,
  "version": "0.2.31",
  "type": "module",
  "description": "Local-first ultra-fast voice input and AI command desktop app",
  "keywords": [
    "speech-to-text",
    "stt",
    "llm",
    "tauri",
    "desktop",
    "voice-input"
  ],
  "author": "EcholIKE Rebuild Contributors",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "build:desktop:ota": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop.ps1 -Bundle nsis -WebView2 online",
    "release:desktop:ota": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-desktop-ota.ps1",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:local-llm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-local-llm.ps1",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.460",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18",
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/jest-dom": "^6.6",
    "@testing-library/react": "^16.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.18",
    "eslint-plugin-react-hooks": "^5.2",
    "eslint-plugin-react-refresh": "^0.4",
    "jsdom": "^25.0",
    "prettier": "^3.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.22",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
