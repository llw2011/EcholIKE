{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EcholIKE",
  "version": "0.2.31",
  "identifier": "com.echolike.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "EcholIKE",
        "width": 1180,
        "height": 820,
        "minWidth": 520,
        "minHeight": 340,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true,
        "visible": false
      },
      {
        "label": "capsule",
        "create": false,
        "title": "EcholIKE Capsule",
        "width": 80,
        "height": 80,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "url": "index.html#capsule"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' https://api.example.com http://127.0.0.1:8787 http://localhost:8787"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "./nsis/minimum-windows.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.example.com/echo-api/app/update/tauri?version={{current_version}}&platform={{target}}&arch={{arch}}&channel=stable"
      ],
      "pubkey": "TAURI_UPDATER_PUBLIC_KEY",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
