{
  "name": "@echolike/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cloud API backend for EcholIKE desktop clients",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "admin:promote": "tsx src/scripts/promote-admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "better-auth": "^1.6.17",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.8.0",
    "postgres": "^3.4.5",
    "stripe": "^18.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.8"
  },
  "license": "AGPL-3.0-only"
}
