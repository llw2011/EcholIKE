# STT_PROVIDER=
# STT_API_KEY=
# STT_BASE_URL=
# STT_MODEL=
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# TTS_PROVIDER=
# TTS_API_KEY=
# TTS_BASE_URL=
# TTS_MODEL=
# TTS_VOICE=
