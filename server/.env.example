# Copy to server/.env and replace every placeholder before starting the server.
# Never commit server/.env or real credentials.
NODE_ENV=development
PORT=8787
PUBLIC_API_BASE_URL=https://api.example.com/echo-api
BETTER_AUTH_URL=https://api.example.com
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/DATABASE
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
PROVIDER_CONTROL_DEADLINE_MS=20000
PROVIDER_CONTROL_MAX_IN_FLIGHT=4

# Optional OAuth, billing, provider, OCR and OTA settings:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
